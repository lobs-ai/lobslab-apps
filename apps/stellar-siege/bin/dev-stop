#!/bin/zsh
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP="$(basename "$ROOT_DIR")"
PID_FILE="$ROOT_DIR/.server.pid"
PORT="${PORT:-47104}"

port_pid() {
  lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1
}

if [[ ! -f "$PID_FILE" ]]; then
  PID="$(port_pid || true)"
  if [[ -n "${PID:-}" ]]; then
    kill "$PID"
    echo "Stopped $APP (pid $PID)"
    exit 0
  fi
  echo "$APP is not running"
  exit 0
fi

PID="$(cat "$PID_FILE")"
if kill -0 "$PID" 2>/dev/null; then
  kill "$PID"
  sleep 1
  if kill -0 "$PID" 2>/dev/null; then
    kill -9 "$PID"
  fi
  echo "Stopped $APP (pid $PID)"
else
  PORT_PID="$(port_pid || true)"
  if [[ -n "${PORT_PID:-}" ]]; then
    kill "$PORT_PID"
    echo "Stopped $APP (pid $PORT_PID)"
  else
    echo "$APP was not running"
  fi
fi

rm -f "$PID_FILE"
