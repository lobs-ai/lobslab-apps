#!/bin/zsh
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP="$(basename "$ROOT_DIR")"
PID_FILE="$ROOT_DIR/.server.pid"
LOG_FILE="$ROOT_DIR/.server.log"
PORT="${PORT:-47100}"

port_pid() {
  lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1
}

if [[ -f "$PID_FILE" ]]; then
  PID="$(cat "$PID_FILE")"
  if kill -0 "$PID" 2>/dev/null; then
    echo "$APP is already running on http://localhost:$PORT (pid $PID)"
    exit 0
  fi
  rm -f "$PID_FILE"
fi

PORT_PID="$(port_pid || true)"
if [[ -n "${PORT_PID:-}" ]]; then
  echo "$APP is already running on http://localhost:$PORT (pid $PORT_PID)"
  echo "$PORT_PID" >"$PID_FILE"
  exit 0
fi

cd "$ROOT_DIR"
PID="$(PORT="$PORT" node --input-type=module <<'JS'
import { spawn } from 'node:child_process';
import { openSync, writeFileSync } from 'node:fs';
const log = openSync('.server.log', 'a');
const child = spawn(process.execPath, ['server.mjs'], {
  detached: true, stdio: ['ignore', log, log], env: process.env,
});
writeFileSync('.server.pid', String(child.pid));
child.unref();
console.log(child.pid);
JS
)"
sleep 1

if kill -0 "$PID" 2>/dev/null; then
  echo "Started $APP on http://localhost:$PORT"
  echo "pid: $PID"
  echo "log: $LOG_FILE"
else
  echo "Failed to start $APP. Check $LOG_FILE"
  exit 1
fi
