#!/bin/zsh
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP="$(basename "$ROOT_DIR")"
PID_FILE="$ROOT_DIR/.server.pid"
LOG_FILE="$ROOT_DIR/.server.log"
PORT="${PORT:-47101}"

port_pid() {
  lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1
}

if [[ -f "$PID_FILE" ]]; then
  PID="$(cat "$PID_FILE")"
  if kill -0 "$PID" 2>/dev/null; then
    echo "$APP is already running on http://localhost:$PORT (pid $PID)"
    exit 0
  fi
  rm -f "$PID_FILE"
fi

PORT_PID="$(port_pid || true)"
if [[ -n "${PORT_PID:-}" ]]; then
  echo "$APP is already running on http://localhost:$PORT (pid $PORT_PID)"
  echo "$PORT_PID" >"$PID_FILE"
  exit 0
fi

cd "$ROOT_DIR"
if [[ ! -d node_modules ]]; then
  echo "Installing dependencies..."
  npm install --silent
fi

PORT="$PORT" nohup node ./server.mjs >>"$LOG_FILE" 2>&1 &
PID=$!
echo "$PID" >"$PID_FILE"
sleep 1

if kill -0 "$PID" 2>/dev/null; then
  echo "Started $APP on http://localhost:$PORT"
  echo "pid: $PID"
  echo "log: $LOG_FILE"
else
  echo "Failed to start $APP. Check $LOG_FILE"
  exit 1
fi
